<odoo>
    <!-- <field name="model">payment.acquirer</field> payment.payment_acquirer_form -->
    <record id="view_b" model="ir.ui.view">
        <field name="name">payment.acquirer</field>
        <field name="model">payment.acquirer.custom</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
    </record>
    <record id="action_b" model="ir.actions.act_window">
        <field name="res_model">my.payment.acquirer</field>
        <field name="view_id" ref="mymod.payment_acquirer_form"/>
