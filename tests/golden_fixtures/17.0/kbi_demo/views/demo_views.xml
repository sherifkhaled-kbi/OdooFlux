<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kbi_demo_view_tree" model="ir.ui.view">
        <field name="name">kbi.demo.tree</field>
        <field name="model">kbi.demo</field>
        <field name="arch" type="xml">
            <tree string="Demo">
                <field name="name"/>
                <field name="amount" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="kbi_demo_view_kanban" model="ir.ui.view">
        <field name="name">kbi.demo.kanban</field>
        <field name="model">kbi.demo</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card"><field name="name"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="kbi_demo_action" model="ir.actions.act_window">
        <field name="name">KBI Demo</field>
        <field name="res_model">kbi.demo</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>
</odoo>
