<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="view_kbi_demo_form" model="ir.ui.view">
            <field name="name">kbi.demo.form</field>
            <field name="model">kbi.demo</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_done" string="Done" type="object" states="draft"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name" attrs="{'invisible': [('state', '=', 'done')],
                                                       'required': [('state', '=', 'draft')]}"/>
                            <field name="code" attrs="{'readonly': ['|', ('state', '=', 'done'), ('name', '=', False)]}"/>
                        </group>
                        <div class="oe_chatter">
                            <field name="message_ids"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_kbi_demo_tree" model="ir.ui.view">
            <field name="name">kbi.demo.tree</field>
            <field name="model">kbi.demo</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="action_kbi_demo" model="ir.actions.act_window">
            <field name="name">KBI Demo</field>
            <field name="res_model">kbi.demo</field>
            <field name="view_mode">tree,form</field>
        </record>
        <template id="assets_kbi_demo" inherit_id="web.assets_backend">
            <xpath expr="." position="inside">
                <script src="/kbi_demo/static/src/js/demo.js"/>
            </xpath>
        </template>
    </data>
</openerp>
