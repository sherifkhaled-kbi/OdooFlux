{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuleHistory",
  "description": "Append-only revision sidecar history/rules/<rule-id>.json (data-model.md RuleHistory, feature 011). Each entry hashes the previous one (prev_hash, null for the first entry).",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "created_by", "created_at", "entries"],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^(\\d+-\\d+|\\*)\\.[a-z_]+\\.[a-z0-9-]+$"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rev",
          "at",
          "actor",
          "action",
          "summary",
          "rule_sha256",
          "provenance",
          "validation_status",
          "prev_hash"
        ],
        "properties": {
          "rev": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "create",
              "edit",
              "disable",
              "enable",
              "retire",
              "link_evidence",
              "add_test",
              "promote",
              "import",
              "supersede"
            ]
          },
          "summary": {
            "type": "string"
          },
          "rule_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provenance": {
            "type": "object"
          },
          "validation_status": {
            "enum": [
              "NOT_RUN",
              "PASSED",
              "FAILED"
            ]
          },
          "prev_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
