{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreModules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "versions"],
  "properties": {
    "schema": {
      "const": "odooflux.core-modules/1"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "evidence", "modules"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+\\.0$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "evidence": {
            "type": "string",
            "pattern": "^EV-\\d{3,}$"
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "replaced_by": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["successors", "evidence"],
              "properties": {
                "successors": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "pattern": "^EV-\\d{3,}$"}
                }
              }
            }
          }
        }
      }
    }
  }
}
