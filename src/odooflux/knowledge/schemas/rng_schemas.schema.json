{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RngSchemas",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "versions"],
  "properties": {
    "schema": {
      "const": "odooflux.rng-schemas/1"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence", "views"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+\\.0$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^EV-\\d{3,}$"
            }
          },
          "views": {
            "type": "object"
          }
        }
      }
    }
  }
}
