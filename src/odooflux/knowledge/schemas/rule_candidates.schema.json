{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuleCandidate",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "rule_id",
      "evidence",
      "proposed_maturity",
      "transformation",
      "risk",
      "status"
    ],
    "properties": {
      "rule_id": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^EV-\\d{3}$"
        }
      },
      "proposed_maturity": {
        "type": "string",
        "minLength": 1
      },
      "transformation": {
        "type": "string",
        "minLength": 1
      },
      "risk": {
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH"
        ]
      },
      "status": {
        "enum": [
          "CANDIDATE"
        ]
      }
    }
  }
}
