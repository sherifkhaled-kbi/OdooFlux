{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "rule_ids",
    "category",
    "source_applicability",
    "target_applicability",
    "description",
    "url",
    "repository",
    "revision",
    "locations",
    "detection_method",
    "proposed_transformation",
    "risk",
    "required_validation",
    "status",
    "checked_on",
    "checked_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EV-\\d{3,}$"
    },
    "origin": {
      "enum": [
        "LEGACY_BUILTIN",
        "KAP_DETERMINISTIC",
        "KAP_MANUAL"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "change_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CH-[0-9a-f]{16}$"
      }
    },
    "official": {
      "type": "boolean"
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(\\d+-\\d+|\\*)\\.[a-z_]+\\.[a-z0-9-]+$"
      }
    },
    "category": {
      "enum": [
        "orm",
        "fields",
        "decorators",
        "views",
        "data_files",
        "qweb",
        "javascript",
        "owl",
        "assets",
        "manifest",
        "security",
        "controllers",
        "cron",
        "tests",
        "python_runtime",
        "dependencies",
        "documentation"
      ]
    },
    "source_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d+\\.0$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d+\\.0$"
        }
      }
    },
    "target_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d+\\.0$"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d+\\.0$"
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9._-]+$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branch",
          "revision",
          "path",
          "line",
          "match",
          "kind"
        ],
        "properties": {
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "snapshot_ref": {
            "type": "string",
            "pattern": "^ss-[0-9a-f]{12}$"
          },
          "branch": {
            "type": "string",
            "pattern": "^(\\d+\\.0|master)$"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "match": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "present",
              "absent"
            ]
          },
          "search_scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "detection_method": {
      "type": "string",
      "minLength": 1
    },
    "proposed_transformation": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "required_validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "VERIFIED",
        "DOCUMENTED_NOT_TESTED",
        "UNVERIFIED",
        "CONFLICTING",
        "NOT_APPLICABLE"
      ]
    },
    "checked_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "checked_by": {
      "type": "string",
      "minLength": 1
    },
    "runtime_test_ref": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
