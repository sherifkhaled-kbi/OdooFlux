{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeLogPatterns",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "patterns"],
  "properties": {
    "schema": {
      "const": "odooflux.runtime-log-patterns/1"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "pattern", "version_range", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z0-9-]+$"
          },
          "class": {
            "enum": [
              "import_error",
              "registry",
              "view_validation",
              "access_rights",
              "data_load",
              "asset_compile",
              "missing_python_dependency"
            ]
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "version_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string", "pattern": "^\\d+\\.0$"},
              "to": {"type": "string", "pattern": "^\\d+\\.0$"}
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^EV-\\d{3,}$"}
          }
        }
      }
    }
  }
}
