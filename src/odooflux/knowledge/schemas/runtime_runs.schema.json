{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeRuns",
  "description": "Recorded runtime validation runs (008 T029-gen). A step is RUNTIME_VALIDATED in the matrix only from a valid record here whose result is PASS. A record is evidence of one real run; never write one for a run that was not executed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runs"],
  "properties": {
    "schema": {"const": "odooflux.runtime-runs/1"},
    "note": {"type": "string"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "step", "source_version", "target_version", "fixture_ids", "image_digest",
                     "source_image_digest", "date", "tool_version", "result", "behavioural"],
        "properties": {
          "id": {"type": "string", "pattern": "^RR-[A-Za-z0-9._-]+$"},
          "step": {"type": "string", "pattern": "^\\d+-\\d+$"},
          "source_version": {"type": "string", "pattern": "^\\d+\\.0$"},
          "target_version": {"type": "string", "pattern": "^\\d+\\.0$"},
          "fixture_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "image_digest": {"type": "string", "pattern": "^[a-z0-9._/-]+@sha256:[0-9a-f]{64}$"},
          "source_image_digest": {"type": ["string", "null"], "pattern": "^[a-z0-9._/-]+@sha256:[0-9a-f]{64}$"},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "tool_version": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL"]},
          "behavioural": {"enum": ["PASS", "FAIL", "UNAVAILABLE", "NOT_RUN"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
